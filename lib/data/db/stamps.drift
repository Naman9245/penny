CREATE TRIGGER prefs_stamp_forward AFTER UPDATE OF updated_at ON prefs
  WHEN NEW.dirty = 1 AND NEW.updated_at <= OLD.updated_at
BEGIN
  UPDATE prefs SET updated_at = OLD.updated_at + 1 WHERE name = NEW.name;
END;
