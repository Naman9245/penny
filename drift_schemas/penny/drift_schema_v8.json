  "fixed_sql": [
    {
      "name": "txns",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"txns\" (\"dirty\" INTEGER NOT NULL DEFAULT 1 CHECK (\"dirty\" IN (0, 1)), \"id\" TEXT NOT NULL, \"amount_paise\" INTEGER NOT NULL CHECK(\"amount_paise\" > 0), \"type\" TEXT NOT NULL, \"category_id\" TEXT NOT NULL, \"merchant\" TEXT NULL, \"occurred_at\" INTEGER NOT NULL, \"source\" TEXT NOT NULL, \"tag\" TEXT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"deleted_at\" INTEGER NULL, \"dedupe_key\" TEXT NULL, \"payee_is_person\" INTEGER NULL CHECK (\"payee_is_person\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "txns_stamp_forward",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TRIGGER txns_stamp_forward AFTER UPDATE OF updated_at ON txns WHEN NEW.dirty = 1 AND NEW.updated_at <= OLD.updated_at BEGIN UPDATE txns SET updated_at = OLD.updated_at + 1 WHERE id = NEW.id;END"
        }
      ]
    },
    {
      "name": "budgets",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"budgets\" (\"dirty\" INTEGER NOT NULL DEFAULT 1 CHECK (\"dirty\" IN (0, 1)), \"id\" TEXT NOT NULL, \"budget_key\" TEXT NOT NULL, \"amount_paise\" INTEGER NOT NULL CHECK(\"amount_paise\" > 0), \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"deleted_at\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
